#!name=哔哩哔哩 VIP
#!desc=我的自定义模块
#!system=ios
#!author=linyu-yuan

[Script]
# 原 B站 模块 bili.vip1，拦截请求
# 【修改这里】把 pattern 里面的 B站 域名和路径，换成你自己项目的接口
bili.vip1 = type=http-request, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite, script-path=https://raw.githubusercontent.com/linyu-yuan/vip/main/scripts/vip1.js, requires-body=true, binary-body-mode=1, engine=webview, max-size=-1, timeout=60

# 原 B站 模块 bili.vip2，拦截响应
# 【修改这里】把 pattern 里面的 B站 路径，换成你自己项目的接口
bili.vip2 = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/, script-path=https://raw.githubusercontent.com/linyu-yuan/vip/main/scripts/vip2.js, requires-body=true, max-size=-1, timeout=60

[MITM]
# 原 B站 模块只解密 grpc.biliapi.net 和 app.bilibili.com
# 【修改这里】换成你自己的目标域名
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com