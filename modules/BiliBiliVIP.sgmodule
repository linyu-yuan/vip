#!name=哔哩哔哩 VIP
#!desc=我的自定义模块
#!system=ios
#!author=linyu-yuan

[Script]
# 放宽了匹配范围：只要 B站 gRPC 接口下的播放相关请求，全部拦截！
bili.vip1 = type=http-request, pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.app\..*, script-path=https://raw.githubusercontent.com/linyu-yuan/vip/main/scripts/vip1.js, requires-body=true, binary-body-mode=1, engine=webview, max-size=-1, timeout=60

bili.vip2 = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/, script-path=https://raw.githubusercontent.com/linyu-yuan/vip/main/scripts/vip2.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com